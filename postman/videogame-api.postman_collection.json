                  "})\r",
                  "\r",
                  "pm.test('Games list is returned', function () {\r",
                  "    const response = pm.response.json()\r",
                  "    pm.expect(response.data.games.games).to.be.an('array')\r",
                  "    pm.expect(response.data.games.games.length).to.be.greaterThan(0)\r",
                  "})\r",
                  "\r",
                  "pm.test('Total count is returned', function () {\r",
                  "    const response = pm.response.json()\r",
                  "    pm.expect(response.data.games.totalCount).to.be.greaterThan(0)\r",
                  "})\r",
                  "\r",
                  "pm.test('Game has required fields', function() {\r",
                  "    const response = pm.response.json()\r",
                  "    const game = response.data.games.games[0]\r",
                  "    pm.expect(game).to.have.property('id')\r",
                  "    pm.expect(game).to.have.property('name')\r",
                  "    pm.expect(game).to.have.property('platform')\r",
                  "    pm.expect(game).to.have.property('genre')\r",
                  "})\r",
                  "\r",
                  "const response = pm.response.json()\r",
                  "if (response.data && response.data.games.games.length > 0) {\r",
                  "    pm.environment.set('gameId', response.data.games.games[0].id)\r",
                  "    pm.environment.set('publisherId', response.data.games.games[0].publisher.id)\r",
