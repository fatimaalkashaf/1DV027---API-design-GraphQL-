      "name": "Authentication",
      "item": [
        {
          "name": "Register - Success",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "const randomNum = Math.floor(Math.random() * 100000)\r",
                  "pm.environment.set('username', `testuser_${randomNum}`)\r",
                  "pm.environment.set('password', 'TestPassword123')"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', function () {\r",
                  "    pm.response.to.have.status(200)\r",
                  "})\r",
                  "\r",
                  "pm.test('Response has data field', function () {\r",
                  "    const response = pm.response.json()\r",
                  "    pm.expect(response).to.have.property('data')\r",
                  "})\r",
                  "\r",
                  "pm.test('Register returns token and user', function() {\r",
                  "    const response = pm.response.json()\r",
                  "    pm.expect(response.data.register).to.have.property('token')\r",
                  "    pm.expect(response.data.register.user).to.have.property('id')\r",
                  "    pm.expect(response.data.register.user).to.have.property('username')\r",
                  "})\r",
                  "\r",
                  "pm.test('Content-Type is application/json', function () {\r",
                  "    pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json')\r",
                  "})\r",
                  "\r",
                  "const response = pm.response.json()\r",
                  "if (response.data && response.data.register) {\r",
                  "    pm.environment.set('token', response.data.register.token)\r",
                  "    pm.environment.set('userId', response.data.register.user.id)\r",
                  "}"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\r\n    \"query\": \"mutation Register($username: String!, $password: String!) { register(username: $username, password: $password) { token user { id username } } }\",\r\n    \"variables\": {\r\n        \"username\": \"{{username}}\",\r\n        \"password\": \"{{password}}\"\r\n    }\r\n}",
